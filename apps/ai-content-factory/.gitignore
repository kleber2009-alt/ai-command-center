# Generated content & runtime data: keep the directory skeleton, ignore contents.
# (backed up via cron per DEPLOYMENT.md, not tracked in the main tree)
data/logs/*
!data/logs/.gitkeep
data/output/*
!data/output/.gitkeep
data/assets/footage/*
!data/assets/footage/.gitkeep
data/assets/b-roll/*
!data/assets/b-roll/.gitkeep
