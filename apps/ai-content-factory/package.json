{
  "name": "@app/ai-content-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous serial-content factory for Instagram: Claude-generated carousels + reels, rendered and delivered to Telegram for manual publishing.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.14.10",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.11.0"
  }
}
