# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone (cron uses this)
TZ=Europe/Moscow

# Optional overrides
CAROUSEL_CRON=0 8 * * *
REELS_CRON=0 14 * * *
INSIGHTS_CRON=0 10 * * 0
HEARTBEAT_CRON=0 23 * * *

# Models
MODEL_OPUS=claude-opus-4-7
MODEL_HAIKU=claude-haiku-4-5-20251001

# Optional: disable real network calls (smoke tests / CI)
DRY_RUN=0
