# Anthropic / Claude API
ANTHROPIC_API_KEY=

# Voyage AI — embeddings for the knowledge base / RAG (Anthropic has no
# embeddings API). Required for `npm run ingest` and RAG-grounded generation.
VOYAGE_API_KEY=
# Optional overrides (defaults shown):
# VOYAGE_MODEL=voyage-3.5
# VOYAGE_DIM=1024

# Knowledge-base SQLite file. Defaults to data/knowledge/factory.db.
# CONTENT_FACTORY_DB=data/knowledge/factory.db

# Telegram delivery (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for the scheduler (Phase 5)
TZ=Europe/Moscow
