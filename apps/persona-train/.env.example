# ─── DB (shared with ai-office via infra-postgres-1.aio) ──────────────
DATABASE_URL=postgresql://aio:CHANGEME@infra-postgres-1:5432/aio

# ─── ElevenLabs ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_xxx

# ─── Anthropic (voice analyzer pipeline) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── HeyGen (avatar training from kruzhki) ────────────────────────────
HEYGEN_API_KEY=

# ─── Higgsfield (alternative avatar provider) ─────────────────────────
HIGGSFIELD_API_KEY=

# ─── Telegram bot (@ilia_pali0_bot) ───────────────────────────────────
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
OWNER_HANDLE=@ilia_pali0

# ─── Storage (MinIO S3) ───────────────────────────────────────────────
S3_ENDPOINT=http://aisales-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=persona-train-media
S3_PUBLIC_URL=https://persona-train.46-62-215-11.nip.io/media

# ─── Local fallback storage (when S3 not configured) ─────────────────-
VOICE_NOTES_DIR=/data/voice-notes
VIDEO_NOTES_DIR=/data/video-notes

# ─── Public URL for callbacks/links ───────────────────────────────────
PUBLIC_BASE_URL=https://persona-train.46-62-215-11.nip.io

# ─── Auto-train threshold (seconds of accumulated voice samples) ──────
AUTO_RETRAIN_SECONDS=180
