# AI Sales · environment variables
# Скопируй в .env и заполни значения. .env не коммитится в git.

# ============ MODE ============
# 1 = mock mode (заглушки вместо реальных API), 0 = production
AISALES_MOCK=1

# ============ Anthropic ============
ANTHROPIC_API_KEY=sk-ant-...

# ============ Voyage (эмбеддинги) ============
VOYAGE_API_KEY=pa-...

# ============ Qdrant (векторная БД) ============
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============ Postgres ============
POSTGRES_URL=postgresql+asyncpg://aisales:CHANGEME@localhost:5432/aisales

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ MinIO ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aisales
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET=aisales-media

# ============ Instagram Graph API ============
IG_APP_SECRET=
IG_VERIFY_TOKEN=aisales-verify-changeme
IG_PAGE_TOKEN=

# ============ Telegram Bot ============
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=

# ============ ElevenLabs (голос Ильи) ============
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ============ Wav2Lip / Sieve (видео-кружочки) ============
SIEVE_API_KEY=
SIEVE_FUNCTION=sieve/wav2lip
# Публичный URL фото лица (для wav2lip · хостится в MinIO)
ILYA_FACE_PHOTO_URL=

# ============ Human-like delays (имитация живой переписки) ============
RESPONSE_DELAY_MIN_S=30
RESPONSE_DELAY_MAX_S=120

# ============ Media cache ============
MEDIA_CACHE_DIR=/tmp/aisales-media-cache

# ============ MinIO public base (для отправки в IG) ============
# Должен быть HTTPS и публично доступен — нужно для IG attachments
MINIO_PUBLIC_BASE=https://media.your-domain.com
MINIO_SECURE=0

# ============ OpenAI (только для Whisper transcription) ============
OPENAI_API_KEY=

# ============ Notifications ============
# TG chat_id Ильи для escalation alerts
ILYA_TG_CHAT_ID=
