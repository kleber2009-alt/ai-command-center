# AI Command Center · environment

# Подключение к нашему aisales-postgres.
# В docker-compose сети (где Next.js рядом с postgres-контейнером):
#   DATABASE_URL=postgresql://aisales:PASSWORD_URLENC@postgres:5432/aisales
#
# На хосте / в dev:
#   DATABASE_URL=postgresql://aisales:PASSWORD_URLENC@127.0.0.1:5432/aisales
DATABASE_URL=

# Используется в src/app/api/command/route.ts для генерации задач AI-командой.
ANTHROPIC_API_KEY=
