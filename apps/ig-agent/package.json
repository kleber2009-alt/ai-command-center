{
  "name": "@app/ig-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Instagram DM AI agent via SendPulse. Webhook in, Claude reply out, Postgres-backed CRM, magic-link admin.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@hono/node-server": "^1.13.2",
    "dotenv": "^16.4.5",
    "hono": "^4.12.31",
    "openai": "^4.104.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
