# --- SendPulse Instagram bot ---
# Create at https://login.sendpulse.com/settings/#api
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
# Optional: pin to a specific connected IG bot id (from /instagram/bots).
# If empty, the agent accepts webhook events from any bot on the account.
SENDPULSE_BOT_ID=
# Token SendPulse appends to webhook URL for shared-secret verification.
# Set to any long random string, then put `?token=<this>` on the webhook URL in SendPulse UI.
SENDPULSE_WEBHOOK_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=
RESPONDER_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
ANALYST_MODEL=claude-sonnet-4-6

# --- Postgres (aisales-postgres container, database ig_agent) ---
# In docker-compose this is built from POSTGRES_PASSWORD; locally override directly.
DATABASE_URL=postgres://aisales:CHANGEME@localhost:5432/ig_agent
POSTGRES_PASSWORD=

# --- Owner notifications via existing Telegram bot ---
# Reuse the tg-agent bot token to DM the owner on hot leads / drafts / health alerts.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# --- Admin panel ---
ADMIN_PORT=8081
ADMIN_PUBLIC_URL=https://ig.46-62-215-11.nip.io
# Rotate to log everyone out. Required for magic-link auth.
ADMIN_SESSION_SECRET=
# Fallback basic auth — magic link wins if both are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Behavior ---
LOG_LEVEL=info
CONFIDENCE_THRESHOLD=0.7
# Comma-separated SendPulse contact ids to never reply to (e.g. test accounts).
IGNORED_CONTACT_IDS=
