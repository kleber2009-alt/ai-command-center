// Деплой hq.aicex.club: Worker hq-aicex (custom domain привязан в Cloudflare).
// Статика отдаётся напрямую; worker.js работает только для /academy-files/* (скиллы академии по коду ученика)
// и /academy-api/* (ИИ-проверка заданий на сайте, тоже по коду ученика).
// cd apps/hq && npm install && npx wrangler deploy   (нужны CLOUDFLARE_API_TOKEN с Workers Scripts: Edit и CLOUDFLARE_ACCOUNT_ID)
// Секреты: npx wrangler secret put ACADEMY_SECRET · npx wrangler secret put ANTHROPIC_API_KEY (без ключа сайт проверяет по простым правилам)
{
  "name": "hq-aicex",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "build": { "command": "python3 academy-src/tools/check_files.py" },
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/academy-files/*", "/academy-api/*"] },
  // ИИ-проверка: не больше 6 запросов в минуту на один код ученика
  "ratelimits": [{ "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }]
}
