generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js v5 / NextAuth core ──────────────────
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  tokenBalance   Int       @default(0)
  plan           String    @default("free") // free | starter | pro | agency
  role           String    @default("user") // user | admin
  telegramId     String?   @unique // numeric TG user id (string for forward-compat), set if logged in via Mini App
  telegramHandle String? // @username at time of TMA login
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  uploads              Upload[]
  avatarGenerations    AvatarGeneration[]
  avatars              Avatar[]
  covers               Cover[]
  videoGenerations     VideoGeneration[]
  videoEdits           VideoEdit[]
  tokenTransactions    TokenTransaction[]
  apiKeys              ApiKey[]
  cryptoInvoices       CryptoInvoice[]
  parserConfig         ParserConfig?
  parserRuns           ParserRun[]
  parserItems          ParserItem[]
  carouselDrafts       CarouselDraft[]
  researchSearches     ResearchSearch[]
  researchAnalyses     ResearchAnalysis[]
  researchHooks        ResearchHook[]
  researchPageAnalyses ResearchPageAnalysis[]
  researchFavorites    ResearchFavorite[]
  researchWatchlist    ResearchWatchlist[]
  researchFolders      ResearchFolder[]
  researchRadars       ResearchRadar[]
  socialAccounts       SocialAccount[]
  scheduledPosts       ScheduledPost[]
  personas             Persona[]
  provenances          Provenance[]
  briefs               Brief[]
  generations          Generation[]
}

// API key для интеграции Persona Studio в сторонние проекты.
// Хранится только SHA-256 хеш ключа — plaintext возвращается клиенту ровно
// один раз при создании. Префикс (первые 8 символов) сохраняется для UI,
// чтобы пользователь мог отличить свои ключи без расшифровки.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // human label
  prefix     String // first 8 chars of plaintext, e.g. "ps_a1b2"
  hashedKey  String    @unique // sha256(plaintext)
  scopes     String    @default("read,write") // CSV: read | write
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([hashedKey])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ──────────────────────────────────────

// Каждая загрузка пользователя — оригинал фото/видео
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl   String // S3 key или signed URL
  fileType  String // image/jpeg, video/mp4, ...
  bytes     Int
  width     Int?
  height    Int?
  status    String   @default("ready") // uploading | ready | rejected
  reason    String? // если rejected
  createdAt DateTime @default(now())

  avatarGenerations AvatarGeneration[]

  @@index([userId, createdAt])
}

// Batch — 1 запрос на «создай 10 аватаров»
model AvatarGeneration {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId    String
  upload      Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | processing | completed | failed | partial
  tokensCost  Int       @default(10)
  jobId       String? // BullMQ job id
  errorMsg    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  avatars Avatar[]

  @@index([userId, createdAt])
  @@index([status])
}

// Каждый из 10 итоговых аватаров
model Avatar {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId  String
  generation    AvatarGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  imageUrl      String // S3 key
  imageThumbUrl String?
  style         String // "luxury-founder" | ...
  styleLabel    String // "Luxury Founder"
  status        String           @default("pending") // pending | done | failed
  promptUsed    String?          @db.Text
  selected      Boolean          @default(false)
  errorMsg      String?
  createdAt     DateTime         @default(now())

  videos         VideoGeneration[]
  covers         Cover[]
  carouselDrafts CarouselDraft[]
  personas       Persona[]

  @@index([userId, createdAt])
  @@index([generationId, style])
}

// Видео из выбранного аватара. Движок — `engine` (heygen-v5 | heygen-v4 |
// omnihuman-1.5). Маршрутизация очереди и валидация полей — в
// src/lib/video-engines.ts.
model VideoGeneration {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId      String
  avatar        Avatar    @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  engine        String    @default("heygen-v5") // VideoEngine slug
  script        String?   @db.Text // для engine.inputMode='script'
  audioUrl      String? // synthesized mp3 (OmniHuman) или advanced override
  language      String    @default("ru")
  voiceId       String?
  aspect        String    @default("9:16") // 9:16 | 1:1 | 16:9
  quality       String    @default("2k") // 1080p | 2k
  background    String?
  subtitles     Boolean   @default(true)
  heygenVersion String    @default("V") // legacy: V | IV (зеркалит engine.heygenVersion)
  motionPrompt  String?   @db.Text // null → MAX_REALISM_MOTION_PROMPT
  status        String    @default("pending") // pending | processing | completed | failed
  engineJobId   String? // generic remote job id (kie/omnihuman)
  heygenJobId   String? // legacy HeyGen video_id
  videoUrl      String?
  tokensCost    Int       @default(30)
  errorMsg      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  edits             VideoEdit[]
  scheduledPosts    ScheduledPost[]
  studioGenerations Generation[]

  @@index([userId, createdAt])
}

// Submagic-монтаж готового видео. Источник — VideoGeneration.videoUrl,
// результат — отдельный mp4 с применённым шаблоном / субтитрами.
model VideoEdit {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoGenerationId String
  videoGeneration   VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  template          String // hormozi | mrbeast | devin | iman-gadzhi | ali-abdaal | minimal
  subtitlesEnabled  Boolean         @default(true) // Submagic всегда включает субтитры; флаг — для UI
  subtitleLanguage  String          @default("ru") // ISO-639-1 (ru | en | es | …)
  brollsEnabled     Boolean         @default(false) // Submagic magicBrolls — авто-вставка B-roll кадров
  submagicProjectId String? // id проекта в Submagic
  status            String          @default("pending") // pending | processing | completed | failed
  resultUrl         String? // финальный mp4 в нашем S3
  tokensCost        Int             @default(15)
  errorMsg          String?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  scheduledPosts    ScheduledPost[]
  studioGenerations Generation[]

  @@index([userId, createdAt])
  @@index([videoGenerationId])
}

// Обложка карусели из выбранного аватара
model Cover {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId    String
  avatar      Avatar    @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  cta         String?
  niche       String?
  style       String    @default("ai-visionary")
  aspect      String    @default("4:5") // 4:5 | 1:1 | 9:16
  imageUrl    String?
  status      String    @default("pending") // pending | processing | completed | failed
  promptUsed  String?   @db.Text
  tokensCost  Int       @default(3)
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

// Аудит всех начислений / списаний токенов
model TokenTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // + начисление, − списание
  type      String // signup_bonus | purchase | charge | refund | manual
  reason    String // "avatar-generation:xxx" | "cover:yyy" | ...
  refId     String? // id связанного объекта
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Parser (Viral Discover) ────────────────────
// Парсер трендовых Instagram-постов конкурентов. Один конфиг на юзера:
// ниша + список competitors + хэштеги + пороги. Каждый запуск создаёт
// ParserRun, и для каждого отранжированного поста — ParserItem
// (с fit-to-niche оценкой от Claude). Из ParserItem пользователь
// одним кликом запускает «создать видео» (VideoGeneration) и далее
// монтаж (VideoEdit) — единый пайплайн Парсер → Видео → Монтаж.
model ParserConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicheDescription    String?  @db.Text // «коучинг продаж B2B, конфронтационный стиль»
  competitors         String[] @default([]) // ["expert_one", "expert_two"] (без @)
  hashtags            String[] @default([]) // ["salescoaching", "b2bsales"] (без #)
  postedWithinDays    Int      @default(7)
  perTargetLimit      Int      @default(25)
  // Пороги для REELS. Apify не у всех постов отдаёт shares —
  // посты без этого поля проходят фильтр (см. scoring.ts).
  minPlays            Int      @default(100000) // 100k views minimum
  minLikes            Int      @default(1000)
  minComments         Int      @default(1000) // 1k comments minimum
  minShares           Int      @default(1000) // 1k reposts/shares minimum (reshareCount от Apify)
  // Пороги для CAROUSELS. У каруселей нет plays и обычно нет shares —
  // фильтр только по likes/comments. По умолчанию те же значения, что для
  // рилсов — пользователь решает мягче/жёстче через форму.
  minCarouselLikes    Int      @default(1000)
  minCarouselComments Int      @default(1000)
  reelsCount          Int      @default(5)
  carouselsCount      Int      @default(5)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Каждый запуск парсера (ручной или плановый). Полные результаты живут
// в ParserItem.
model ParserRun {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("pending") // pending | processing | completed | failed
  postsScanned   Int       @default(0)
  reelsFound     Int       @default(0)
  carouselsFound Int       @default(0)
  claudeSummary  String?   @db.Text
  errorMsg       String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  items ParserItem[]

  @@index([userId, startedAt])
}

// Каждый отранжированный пост из результатов парсера.
// status: new | used (отправлен в работу) | dismissed (пользователь скрыл)
model ParserItem {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId             String
  run               ParserRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  url               String // https://www.instagram.com/reel/<shortcode>/
  shortcode         String?
  kind              String // reel | carousel
  owner             String? // ownerUsername без @
  thumbnailUrl      String?
  caption           String?   @db.Text
  plays             Int       @default(0)
  likes             Int       @default(0)
  comments          Int       @default(0)
  ageHours          Float     @default(0)
  velocityScore     Float     @default(0) // 0..1, composite от scoring.ts
  fitScore          Int? // 1..10 от Claude
  fitWhy            String? // 6-12 слов, почему такой score
  // Уникализированный сценарий по структуре хук→боль→раскрытие→CTA, который
  // подставится в VideoForm на /videos/new когда юзер жмёт «Создать видео».
  // Генерится Claude по caption+niche, кэшируется здесь, чтобы повторный
  // переход не делал лишний rewrite.
  rewrittenScript   String?   @db.Text
  status            String    @default("new") // new | used | dismissed
  videoGenerationId String? // если уже отправлен в работу
  createdAt         DateTime  @default(now())

  carouselDrafts CarouselDraft[]

  @@index([userId, createdAt])
  @@index([runId])
}

// ── Carousel drafts ────────────────────────────
// Многослайдовая Instagram-карусель, сгенерированная по тексту парсер-айтема
// (или по произвольному caption). Текст каждого слайда уникализируется
// Claude'ом, первый слайд — обложка с выбранным Avatar'ом. Реальный рендер
// PNG'ов — отдельный шаг (Phase 2, Puppeteer/HTML-шаблон).
//
// slides — JSON-массив { title, body, accent? }. Не нормализуем в отдельную
// таблицу, потому что редактирование происходит цельно (форма с N textarea).
model CarouselDraft {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Источник: если из парсера — линк на ParserItem, иначе free-form caption.
  parserItemId  String?
  parserItem    ParserItem? @relation(fields: [parserItemId], references: [id], onDelete: SetNull)
  // Аватар для первого (обложечного) слайда — выбирается из готовых Avatar.
  coverAvatarId String?
  coverAvatar   Avatar?     @relation(fields: [coverAvatarId], references: [id], onDelete: SetNull)
  slidesCount   Int         @default(6)
  // Стиль рендера слайдов — определяет шаблон/палитру/типографику.
  // Каталог в src/lib/carousel/styles.ts: persona-minimal (dark serif),
  // clickbait-bold (paliy-style white+cobalt), knox-cream (cream duotone).
  style         String      @default("persona-minimal")
  // [{ title: string, body: string, accent?: string }]
  slides        Json
  // draft | rendered | failed. Пока всегда draft — render отдельный pipeline.
  status        String      @default("draft")
  // S3 URLs финальных PNG'ов в порядке слайдов (заполняется в Phase 2 render).
  imageUrls     String[]    @default([])
  tokensCost    Int         @default(0)
  errorMsg      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?

  @@index([userId, createdAt])
  @@index([parserItemId])
}

// Инвойсы CryptoBot (@CryptoBot Telegram). Создаются перед редиректом в bot_invoice_url,
// мармаются paid вебхуком после оплаты, токены зачисляются идемпотентно (по invoiceId).
model CryptoInvoice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId String    @unique // id из CryptoBot
  pack      String // "starter" | "pro" | "agency"
  tokens    Int // сколько токенов начислить при оплате
  asset     String // "USDT" | "TON" | "BTC" | ...
  amount    String // строка чтоб не терять точность ("9.50")
  status    String    @default("active") // active | paid | expired | failed
  payUrl    String // bot_invoice_url
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId, createdAt])
  @@index([invoiceId])
}

// ── Research (Viral Content Research, Badunga-style) ──
// Параллельный стек к Parser*. Парсер был про "конфиг юзера → competitors+hashtags".
// Research — про on-demand поиск по нише, индексацию авторов и расчёт
// относительной виральности (views / median_views автора).
//
// ResearchAuthor — кэш профиля + медиана последних N рилсов. Создаётся
// при первом появлении автора в выдаче и рефрешится по TTL.
// Уникальность: (platform, username).
model ResearchAuthor {
  id            String    @id @default(cuid())
  platform      String    @default("instagram") // instagram | tiktok | youtube (v2+)
  username      String // без @
  externalId    String? // IG user id если удалось вытащить
  followers     Int?
  postsCount    Int?
  avatarUrl     String?
  profileUrl    String?
  categories    String[]  @default([]) // авто-теги ниши
  // Главное поле: медиана просмотров последних medianWindow рилсов.
  // На её основе считается виральность каждого ролика (views / medianViews).
  medianViews   Float?
  medianWindow  Int       @default(30)
  engagementAvg Float? // средний ER по последним рилсам
  lowConfidence Boolean   @default(false) // true если < N рилсов в истории
  lastIndexedAt DateTime?
  rawStats      Json? // сырой ответ профильного скрейпера
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reels         ResearchReel[]
  pageAnalyses  ResearchPageAnalysis[]
  watchlistedBy ResearchWatchlist[]

  @@unique([platform, username])
  @@index([lastIndexedAt])
}

// ResearchReel — один ролик с посчитанными метриками относительно автора.
// Уникальность: (platform, externalId) — реальный IG media id или shortcode,
// в зависимости от того что отдаёт actor.
model ResearchReel {
  id             String         @id @default(cuid())
  platform       String         @default("instagram")
  externalId     String // shortcode | media id (то, что уникально у платформы)
  authorId       String
  author         ResearchAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  url            String
  videoUrl       String?
  thumbnailUrl   String?
  caption        String?        @db.Text
  captionHash    String? // sha1 от нормализованной caption — для дедупа на этапе 1
  postedAt       DateTime?
  durationSec    Int?
  views          Int            @default(0)
  likes          Int            @default(0)
  comments       Int            @default(0)
  shares         Int            @default(0)
  music          String?
  hashtags       String[]       @default([])
  language       String? // BCP-47, опционально
  postType       String         @default("reel") // reel | image | carousel
  // ── Расчётные метрики (см. lib/research/metrics.ts) ──
  virality       Float? // views / authorMedian, округлено до 0.1
  engagementRate Float? // (likes + comments) / views * 100
  velocity       Float? // views / max(дней с публикации, 0.5)
  viralScore     Float? // 0..100 композит по ТЗ §2
  reach          Float? // views / followers (если followers есть)
  nicheTags      String[]       @default([])
  indexedAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transcripts ResearchTranscript[]
  analyses    ResearchAnalysis[]
  hooks       ResearchHook[]
  favorites   ResearchFavorite[]
  provenances Provenance[]
  briefs      Brief[]

  @@unique([platform, externalId])
  @@index([authorId])
  @@index([viralScore])
  @@index([postedAt])
}

// Транскрипт ролика. На Этапе 3 источник = "stub" (caption fallback) либо
// "whisper" (когда подключим self-hosted faster-whisper). Поле improved
// помечает текст, прогнанный через Claude для очистки филлеров и разбивки
// на абзацы.
model ResearchTranscript {
  id        String       @id @default(cuid())
  reelId    String
  reel      ResearchReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  lang      String       @default("ru")
  text      String       @db.Text
  improved  Boolean      @default(false)
  source    String       @default("stub") // stub | whisper | api | caption
  createdAt DateTime     @default(now())

  @@index([reelId])
}

// Глубокий анализ ролика по ТЗ §6.2. JSON-структура диктуется промптом
// в lib/research/analyze.ts — Prisma хранит «как есть», валидирует Claude.
model ResearchAnalysis {
  id              String       @id @default(cuid())
  reelId          String
  reel            ResearchReel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hooks           Json // [{text, formula, strength}]
  storytelling    Json // {structure, beats[]}
  format          Json // {type, duration_band, pacing}
  style           Json // {visual, audio, text_overlay}
  whyViral        String       @db.Text
  recommendations Json // string[]
  model           String // claude-sonnet-4-6 | ...
  tokensCost      Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([reelId, createdAt])
  @@index([userId, createdAt])
}

// Анализ страницы автора (ТЗ §7). Уникален на (authorId, userId) — каждый
// пользователь получает свой персональный разбор, но один автор для одного
// юзера хранится один.
model ResearchPageAnalysis {
  id              String         @id @default(cuid())
  authorId        String
  author          ResearchAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary         String         @db.Text
  outliers        Json // [{reel_id, virality, why}]
  cadence         Json // {posts_per_week, best_days, best_time}
  bestFormats     Json // string[]
  bestTopics      Json // string[]
  recurringHooks  Json // string[]
  recommendations Json // string[]
  model           String
  tokensCost      Int            @default(0)
  createdAt       DateTime       @default(now())

  @@unique([authorId, userId])
  @@index([userId, createdAt])
}

// Галерея хуков (ТЗ §9). Auto — собираются из ResearchAnalysis.hooks,
// generated — POST /hooks/generate, custom — пользовательские.
model ResearchHook {
  id           String        @id @default(cuid())
  text         String        @db.Text
  formula      String // вопрос | кейс | личный опыт | негатив | обучение | проблема | против течения | секрет | список | сравнение | свои
  sourceReelId String?
  sourceReel   ResearchReel? @relation(fields: [sourceReelId], references: [id], onDelete: SetNull)
  niche        String?
  language     String?
  // Если хук вытащен из вирусного ролика — сюда падают views того ролика.
  // Сортировка «сначала самые залетевшие» использует именно это поле.
  sourceViews  Int           @default(0)
  // origin = auto (из ResearchAnalysis) | generated (Claude по формуле) | custom (юзер)
  origin       String        @default("auto")
  isCustom     Boolean       @default(false)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@index([formula])
  @@index([sourceViews])
  @@index([userId, createdAt])
}

// Избранное на любой сущности research (reel | author | hook).
// Универсальная таблица — itemType + itemId без FK, FK создал бы по 3
// колонки и заставил бы делать null-FK pattern. Орфаны вычищаем
// отдельным cron'ом или просто скрываем в UI если не найдено.
model ResearchFavorite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String // reel | author | hook
  itemId    String
  // Опциональная мягкая привязка для reels — позволяет включить reel в
  // запрос с include: {favorites: true}. Не обязательная.
  reelId    String?
  reel      ResearchReel? @relation(fields: [reelId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt])
}

// Авторы в наблюдении пользователя (ТЗ §10). refresh* — параметры для
// будущего n8n cron, который пройдёт по списку и вызовет indexAuthor.
model ResearchWatchlist {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId        String
  author          ResearchAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  refreshInterval Int            @default(24) // часов
  lastRefreshAt   DateTime?
  addedAt         DateTime       @default(now())

  @@unique([userId, authorId])
  @@index([lastRefreshAt])
}

// Кэш поисковой выдачи. Ключ = (niche normalized + filtersHash).
// resultReelIds — массив ResearchReel.id в порядке отдачи.
model ResearchSearchCache {
  id            String   @id @default(cuid())
  niche         String // нормализованная (lowercase + trim)
  filtersHash   String // sha1 от сериализованных фильтров
  resultReelIds String[] @default([])
  summary       String? // niche-aggregate summary от Claude если был
  expansion     Json? // { keywords, hashtags } от expand-niche
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@unique([niche, filtersHash])
  @@index([expiresAt])
}

// История поисков пользователя. Не путать с кэшем — этот журнал нужен
// для UI (последние ниши пользователя) и для радаров позже.
model ResearchSearch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche         String
  filters       Json
  resultReelIds String[] @default([])
  summary       String?  @db.Text
  cacheHit      Boolean  @default(false)
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Папки/проекты пользователя (ТЗ §10). Один из 3 типов:
//   - bloggers → folder_items.itemType='author', itemId=ResearchAuthor.id
//   - videos   → folder_items.itemType='reel',   itemId=ResearchReel.id
//   - ideas    → folder_items.itemType='idea',   itemId=произвольный string
//     (например, slug recommendation'а из ResearchAnalysis или текст идеи)
model ResearchFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String // bloggers | videos | ideas
  createdAt DateTime @default(now())

  items ResearchFolderItem[]

  @@index([userId, type])
}

model ResearchFolderItem {
  id        String         @id @default(cuid())
  folderId  String
  folder    ResearchFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  itemType  String // author | reel | idea
  itemId    String
  note      String? // для idea — текст идеи; для других — заметка
  createdAt DateTime       @default(now())

  @@unique([folderId, itemType, itemId])
  @@index([folderId, createdAt])
}

// Радар — сохранённый поисковый запрос (ниша + фильтры), который cron
// перезапускает по расписанию и копит новые выбросы. Связь с
// ResearchSearch выдачей — через journal-таблицу (последний run).
model ResearchRadar {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche         String
  filters       Json
  // Интервал перезапуска в часах (24 = раз в сутки). n8n/BullMQ cron
  // фильтрует по (now - lastRunAt) > interval.
  intervalHrs   Int       @default(24)
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  // Последняя замеченная выдача — массив ResearchReel.id из последнего
  // run'а. Используется UI для подсветки "что нового по сравнению с
  // предыдущим run'ом".
  lastResultIds String[]  @default([])
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([enabled, lastRunAt])
}

// Месячный трекер расхода на Apify (ТЗ §16). По одному ряду на YYYYMM.
// Инкрементируется после каждого скрейпа (см. lib/research/apify-budget.ts).
// `cents` хранится как Int, конвертация в $ только в UI/логах.
model ResearchApifyUsage {
  month        String   @id // YYYYMM, например "202606"
  callsMade    Int      @default(0)
  itemsScraped Int      @default(0)
  estCostCents Int      @default(0)
  // Маркер последнего алерта (75/90/100), чтобы не спамить тем же уровнем
  lastAlertPct Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// Per-item override for the left sidebar. Absence = visible (default).
// Only items the admin toggled off are stored here with `hidden = true`.
model SidebarItemOverride {
  itemKey   String   @id
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ── Scheduler & Autoposting ─────────────────────
// Замыкает pipeline: готовое видео (VideoGeneration / VideoEdit) →
// запланированная публикация в подключённые каналы (Instagram / Telegram).
//
// SocialAccount — подключённый канал публикации. ScheduledPost — единица
// планирования (одно видео + caption + время). PostTarget — фан-аут одной
// публикации на N каналов (можно постить и в IG, и в TG одновременно).

// Подключённый канал публикации. Для Instagram храним зашифрованный
// long-lived Graph-токен (lib/publish/crypto), для Telegram — chatId канала
// (бот должен быть админом). externalId: IG business user id / TG chat id.
model SocialAccount {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String // instagram | telegram
  displayName    String // @handle / название канала
  externalId     String // IG business user id  /  TG chat id (-100… или @channel)
  accessToken    String?   @db.Text // long-lived IG token, ЗАШИФРОВАН (AES-256-GCM)
  tokenExpiresAt DateTime?
  meta           Json? // { fbPageId, igUsername, channelTitle, ... }
  status         String    @default("active") // active | expired | revoked
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  postTargets PostTarget[]

  @@unique([userId, platform, externalId])
  @@index([userId])
}

// Запланированная публикация. mediaUrl — снапшот итогового mp4 на момент
// планирования (чтобы переименование/удаление исходника не ломало пост).
// status: draft (черновик) | scheduled (в очереди на время) |
//   publishing (sweep взял в работу) | published (все таргеты ok) |
//   partial (часть таргетов failed) | failed (все failed) | canceled.
model ScheduledPost {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType        String // video | edit
  videoGenerationId String?
  videoGeneration   VideoGeneration? @relation(fields: [videoGenerationId], references: [id], onDelete: SetNull)
  videoEditId       String?
  videoEdit         VideoEdit?       @relation(fields: [videoEditId], references: [id], onDelete: SetNull)
  mediaUrl          String           @db.Text
  caption           String?          @db.Text
  scheduledAt       DateTime
  status            String           @default("scheduled")
  publishedAt       DateTime?
  errorMsg          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  targets PostTarget[]

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
}

// Фан-аут одной публикации на конкретный канал. remoteId / permalink
// заполняются после успешной отправки. attempts — для backoff/диагностики.
model PostTarget {
  id              String        @id @default(cuid())
  scheduledPostId String
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        String // денормализовано (instagram | telegram)
  status          String        @default("pending") // pending | publishing | published | failed
  remoteId        String? // IG media id / TG message_id
  permalink       String? // ссылка на опубликованный пост
  attempts        Int           @default(0)
  errorMsg        String?
  publishedAt     DateTime?

  @@index([scheduledPostId])
}

// ── Studio (Мастер-ТЗ Persona Studio) ──────────────
// Спека пишет схемы в Postgres-схему `studio.*`; на нашем Prisma-стеке это
// обычные модели. Модуль A (Persona) и сквозное требование §2 (антиплагиат /
// провенанс) — фундамент S1, на котором строятся бриф → генерация →
// публикация (SocialAccount/ScheduledPost/PostTarget уже есть в схеме).

// Persona — first-class сущность (Мастер-ТЗ §3, Модуль A). Связывает выбранный
// аватар (talking-head источник), голос (ElevenLabs voice id), бренд-кит и
// tone-of-voice. Одна персона помечается дефолтной и подставляется в воркспейс
// генерации одним кликом.
model Persona {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  avatarId       String? // выбранный Avatar (talking-head источник), опц.
  avatar         Avatar?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  avatarModelRef String? // ссылка на обученный аватар (kie.ai/OmniHuman), если есть
  voiceId        String? // ElevenLabs voice id (клон или сток)
  voiceProvider  String   @default("elevenlabs")
  lang           String   @default("ru")
  brand          Json     @default("{}") // { primary, accent, fontHeading, fontBody, logoUrl }
  tone           Json     @default("{}") // { examples: string[], taboo: string[], length: short|medium|long }
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  briefs Brief[]

  @@index([userId, createdAt])
  @@index([userId, isDefault])
}

// Provenance — сквозное требование §2 (антиплагиат / трансформация). Каждый
// сгенерированный ассет хранит источник-вдохновение и результат similarity-gate.
// Контент с gate='block' не уходит в «Опубликовано». `assetId` ссылается на
// будущую studio.generations (S2) свободной строкой.
model Provenance {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId      String? // generation id (S2) — пока свободная ссылка
  assetType    String        @default("generation") // generation | script | content_item
  sourceReelId String?
  sourceReel   ResearchReel? @relation(fields: [sourceReelId], references: [id], onDelete: SetNull)
  similarity   Float? // cosine 0..1; null если эмбеддинги/источник недоступны
  gate         String // pass | warn | block
  reason       String? // диагностика (no_embeddings_or_source | embed_failed | ...)
  checkedAt    DateTime      @default(now())

  @@index([userId, checkedAt])
  @@index([assetId])
  @@index([sourceReelId])
}

// Brief — заказ на генерацию (Мастер-ТЗ §4, Модуль B). Создаётся из находки
// Research («Клонировать формат») или с нуля. §2: хранит ТОЛЬКО структуру
// (архетип хука, формат, длину, тайминг), а НЕ дословный текст источника.
model Brief {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId     String?
  persona       Persona?      @relation(fields: [personaId], references: [id], onDelete: SetNull)
  sourceReelId  String? // источник-вдохновение (может быть null — с нуля)
  sourceReel    ResearchReel? @relation(fields: [sourceReelId], references: [id], onDelete: SetNull)
  hookArchetype String? // тип хука (структура, не текст)
  format        String? // talking-head | listicle | story | ...
  lengthSec     Int? // целевая длина
  lang          String        @default("ru")
  topic         String?       @db.Text // наш угол/тема (net-new, не текст источника)
  status        String        @default("draft") // draft | ready
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  generations Generation[]

  @@index([userId, createdAt])
  @@index([personaId])
}

// Generation — прогон пайплайна по брифу (Мастер-ТЗ §4). Стадии:
// script → voice → video → edit → done (или error). Тяжёлые стадии
// переиспользуют существующие VideoGeneration (OmniHuman) и VideoEdit
// (Submagic). similarity/gate — результат §2-проверки сценария.
model Generation {
  id                String           @id @default(cuid())
  briefId           String
  brief             Brief            @relation(fields: [briefId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage             String           @default("script") // script | voice | video | edit | done | error
  status            String           @default("pending") // pending | processing | completed | failed
  script            String?          @db.Text // net-new сценарий под персону
  similarity        Float? // §2 cosine к источнику
  gate              String? // pass | warn | block
  videoGenerationId String? // переиспользуемый VideoGeneration (OmniHuman)
  videoGeneration   VideoGeneration? @relation(fields: [videoGenerationId], references: [id], onDelete: SetNull)
  videoEditId       String? // переиспользуемый VideoEdit (Submagic)
  videoEdit         VideoEdit?       @relation(fields: [videoEditId], references: [id], onDelete: SetNull)
  finalUrl          String? // итог после автомонтажа
  costCredits       Int              @default(0)
  errorMsg          String?
  meta              Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([briefId])
}
