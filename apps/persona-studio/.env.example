# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/persona_studio"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (for sign in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic-link (optional, falls back to Google-only)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Persona Studio <noreply@example.com>"

# Gemini / Nano Banana 2
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="persona-studio"
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Token economics
TOKENS_FREE_BALANCE="10"
TOKENS_AVATAR_GENERATION="10"
TOKENS_COVER_GENERATION="3"

# Admin
ADMIN_EMAILS="you@example.com"
