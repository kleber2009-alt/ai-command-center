# ── App ────────────────────────────────────────
APP_URL=http://localhost:3020
NODE_ENV=development

# ── Database (Postgres) ────────────────────────
# Локально: создать БД `persona_studio` в aisales-postgres
# Прод: тот же aisales-postgres контейнер, отдельная БД persona_studio
DATABASE_URL=postgresql://aisales:CHANGE_ME@localhost:5432/persona_studio?schema=public

# ── Auth (NextAuth v5 / Auth.js) ───────────────
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_TRUST_HOST=true

# Email magic-link через локальный mailpit (как в ai-hub)
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@persona-studio.local

# Опционально — Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Redis (BullMQ + caching) ───────────────────
REDIS_URL=redis://localhost:6379/3

# ── Storage (S3-compatible: MinIO / R2 / AWS S3) ─
# Default: MinIO (как в ai-hub)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=persona-studio-media
S3_PUBLIC_URL=http://localhost:9000/persona-studio-media
S3_FORCE_PATH_STYLE=true

# ── AI Providers ───────────────────────────────
# kie.ai — unified marketplace для Nano Banana 2 (Google Gemini 2.5/3.1 Flash Image)
# Получить ключ: https://kie.ai/api-key
KIE_API_KEY=
KIE_IMAGE_MODEL=nano-banana-2
KIE_BASE_URL=https://api.kie.ai/api/v1

# Worker grouping (PS-13): all | generation | cron. Default 'all' (one process).
# In prod docker-compose sets generation/cron per container. (env-driven)
WORKER_GROUP=all

# Worker concurrency (опционально)
WORKER_AVATAR_CONCURRENCY=2
WORKER_PER_STYLE_PARALLEL=3

# HeyGen (optional — video engine degrades gracefully without it)
HEYGEN_API_KEY=

# ── Telegram (bot + Stars billing webhook) ─────
TELEGRAM_BOT_TOKEN=
# REQUIRED in production: secret passed to setWebhook(secret_token=…) and
# checked on every /api/telegram/webhook call. Without it the webhook (which
# credits tokens) fails closed with 503 in prod. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Tokens ─────────────────────────────────────
# Calibrated to provider COGS for ~55% margin on Pro. See docs/UNIT_ECONOMICS.md.
SIGNUP_BONUS_TOKENS=10
COST_AVATAR_GENERATION=10
COST_COVER_GENERATION=3
COST_HEYGEN_VIDEO=100
COST_OMNIHUMAN_VIDEO=140
COST_SUBMAGIC_EDIT=15
COST_SLIDE_IMAGE=3

# ── Rate limiting (per-user, per-minute) ──────
RATELIMIT_RESEARCH_PER_MIN=10
RATELIMIT_GENERATE_PER_MIN=20

# ── Moderation ─────────────────────────────────
# Avatar uploads are checked (single human face + SFW) via Anthropic vision
# (reuses ANTHROPIC_API_KEY). Without that key moderation is skipped & logged;
# set MODERATION_REQUIRED=true to reject uploads when moderation is unavailable.
MODERATION_REQUIRED=false

# ── Free-plan watermark ────────────────────────
# When true, generated avatar/cover images for never-paid users get a
# "Persona Studio" watermark (paying users are never marked). Off by default.
WATERMARK_FREE_PLAN=false

# ── Limits ─────────────────────────────────────
MAX_UPLOAD_BYTES=20971520                     # 20 MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/quicktime
