# Copy to .env and fill in the values that apply to your deploy.
# Anything left blank degrades gracefully — see apps/transcribe/CLAUDE.md
# (or the root CLAUDE.md) for the per-key behavior.

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Supabase (history + /me library + tasks) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- yt-dlp companion service (Instagram / TikTok / X / YouTube fallback) ---
YTDLP_SERVICE_URL=
YTDLP_SERVICE_API_KEY=

# --- Telegram Mini App auth ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUIRE_INIT_DATA=
OWNER_TELEGRAM_ID=

# --- Caddy / proxy ---
# ":80" → plain HTTP on every Host header (good for nip.io / raw IP).
# A real domain like "transcribe.example.com" triggers automatic HTTPS
# via Let's Encrypt — DNS must point at this server first.
SITE_HOST=:80
