# transcribe · environment template
# Copy to .env and fill in the values. Compose reads this file
# automatically (same directory).

# ── Required AI providers ──
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# ── Supabase (Phase 1 keeps the managed DB) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Telegram Mini App ──
# When TELEGRAM_BOT_TOKEN is set, API routes verify initData HMAC.
# Set TELEGRAM_REQUIRE_INIT_DATA=true to forbid browser-only access.
# OWNER_TELEGRAM_ID gates owner-only routes (/admin, /me/*, history).
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUIRE_INIT_DATA=
OWNER_TELEGRAM_ID=

# ── Stripe billing (Phase 1) ──
# Secret key from Stripe Dashboard → API keys
STRIPE_SECRET_KEY=
# Signing secret from Stripe Dashboard → Webhooks → <endpoint> → Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products (recurring, monthly)
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Public URL of the app — used for checkout redirect URLs
NEXT_PUBLIC_APP_URL=

# ── Extractors ──
# Apify is the preferred path for Instagram (keeps our IG account and
# server IP off instagram.com). yt-dlp service remains as fallback for
# Instagram and is required for TikTok / X / YouTube cookies-based path.
APIFY_API_TOKEN=
YTDLP_SERVICE_URL=
YTDLP_SERVICE_API_KEY=
