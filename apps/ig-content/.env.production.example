# ig-content — production env (Supabase Cloud + Docker on Hetzner)
# Copy to `.env` in this directory and fill in real values, then:
#   docker compose up -d --build
#
# NOTE: NEXT_PUBLIC_* are inlined at BUILD time (used as compose build args).
# If you change them you MUST rebuild the image: `docker compose up -d --build`.

# --- Supabase Cloud (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Server-only. Never exposed to the browser. (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App ---
# Public origin (used for Supabase auth redirect / callback). Must match the
# Site URL configured in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=https://igcontent.46-62-215-11.nip.io

# Demo mode MUST be off in production (defaults off if unset).
IGC_DEMO=0
NEXT_PUBLIC_IGC_DEMO=0
