# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
# Model used by all content agents
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — embeddings for the knowledge base / RAG (text-embedding-3-small).
# Without it, vector search is skipped and retrieval falls back to score ranking.
OPENAI_API_KEY=sk-...
