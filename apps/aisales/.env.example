# apps/aisales/.env.example
# Скопируй в apps/aisales/.env и заполни. .env закоммичен в .gitignore.
# Сгенерировано из /home/aisales/aisales/.env

POSTGRES_USER=
POSTGRES_PASSWORD=
# URL-encoded версия пароля (нужна для command-center DATABASE_URL и
# любых других сервисов, где пароль интерполируется в connection-string).
# Если в пароле нет '/' '+' '@' '#' '?' ':' — можно скопировать пароль как есть.
# Иначе экранируй:  '/' → %2F, '+' → %2B, '@' → %40, '#' → %23, '?' → %3F, ':' → %3A
POSTGRES_PASSWORD_URLENC=
POSTGRES_DB=
REDIS_PASSWORD=
QDRANT_API_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_SECRET_KEY=

# ── AI Command Center ──
# Используется в /api/command для генерации задач AI-командой.
ANTHROPIC_API_KEY=
