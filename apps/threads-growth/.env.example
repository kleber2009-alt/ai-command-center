# ── AI Threads Growth Agent — окружение ──────────────────────────────────────
# Скопируй в .env (НЕ коммитится) и заполни. Пустые опц. ключи отключают
# соответствующий внешний вызов (он падает с понятным сообщением при попытке).

# Хранилище (psycopg3 драйвер). На проде можно указать общий aisales-postgres.
DATABASE_URL=postgresql+psycopg://threads_viral:threads_viral@db:5432/threads_growth

# Шифрование access_token аккаунтов (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Дискавери (Apify) — id акторов под каждый источник.
APIFY_TOKEN=
APIFY_THREADS_ACTOR=
APIFY_TWITTER_ACTOR=
APIFY_REDDIT_ACTOR=
LOOKBACK_HOURS=72
DEDUP_THRESHOLD=0.92

# Скоринг (категории по xn_score и веса композита) — можно не трогать.
XN_CATEGORY_A=5.0
XN_CATEGORY_B=3.0
XN_CATEGORY_C=1.5
RANK_W_XN=0.6
RANK_W_VELOCITY=0.3
RANK_W_ENGAGEMENT=0.1

# Claude (Agent SDK / API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ADAPT_VARIANTS=5

# Уникализация (антиплагиат) — пороги отбраковки адаптаций.
TEXT_SIMILARITY_MAX=0.25
SEMANTIC_SIMILARITY_MAX=0.80

# Эмбеддинги (Voyage; опц. — без них дедуп падает на лексическую эвристику).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1536

# Threads Graph API.
THREADS_API_BASE=https://graph.threads.net/v1.0

# Telegram-апрув (MVP).
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
