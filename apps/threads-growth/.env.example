# ── AI Threads Growth Agent — окружение ──────────────────────────────────────
# Скопируй в .env (НЕ коммитится) и заполни. Пустые опц. ключи отключают
# соответствующий внешний вызов (он падает с понятным сообщением при попытке).

# Хранилище (psycopg3 драйвер). На проде можно указать общий aisales-postgres.
DATABASE_URL=postgresql+psycopg://threads_viral:threads_viral@db:5432/threads_growth

# Шифрование access_token аккаунтов (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Дискавери (Apify) — id акторов под каждый источник.
APIFY_TOKEN=
APIFY_THREADS_ACTOR=futurizerush/meta-threads-scraper
APIFY_TWITTER_ACTOR=
APIFY_REDDIT_ACTOR=
LOOKBACK_HOURS=72
DEDUP_THRESHOLD=0.92

# Скоринг (категории по xn_score и веса композита) — можно не трогать.
XN_CATEGORY_A=5.0
XN_CATEGORY_B=3.0
XN_CATEGORY_C=1.5
RANK_W_XN=0.6
RANK_W_VELOCITY=0.3
RANK_W_ENGAGEMENT=0.1

# Claude (Agent SDK / API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ADAPT_VARIANTS=5

# Уникализация (антиплагиат) — пороги отбраковки адаптаций.
TEXT_SIMILARITY_MAX=0.25
SEMANTIC_SIMILARITY_MAX=0.80

# Эмбеддинги (Voyage; опц. — без них дедуп падает на лексическую эвристику).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1536

# Threads Graph API.
THREADS_API_BASE=https://graph.threads.net/v1.0

# Telegram-апрув (MVP). Бот шлёт владельцу черновики на ревью с inline-кнопками.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Сколько карточек слать за один /drafts|/replies.
REVIEW_BATCH=10
# HH:MM UTC — ежедневный авто-пуш на ревью. Пусто = только вручную.
# ВНИМАНИЕ: значение в одну строку, БЕЗ инлайн-комментария после `=`
# (dotenv заберёт `#...` в значение и бот упадёт на парсинге времени).
REVIEW_DAILY_TIME=

# Telegram Mini App (полная панель, /app). Авторизация — по initData владельца
# (тот же TELEGRAM_BOT_TOKEN + OWNER_TELEGRAM_ID). 1 = отключить проверку
# (ТОЛЬКО для локальной разработки; на проде держать пустым/0).
WEBAPP_AUTH_DISABLED=0

# ── Воронка Threads → Telegram (app/funnel, скилл threads-telegram-funnel) ────
# Модель агентов (план, ветки, проверка, правки, ответы). 1 = server-side fallback при отказе.
FUNNEL_MODEL=claude-opus-5-5
FUNNEL_FALLBACKS=1
FUNNEL_TZ=Europe/Moscow
# Решение 4: слоты выхода.
FUNNEL_SLOTS=10:00,13:00,18:00
# Командная форум-группа и id темы «Threads» (message_thread_id). Пусто = личка владельца.
FUNNEL_CHAT_ID=
FUNNEL_TOPIC_ID=
# Кто кроме владельца жмёт кнопки карточек (Telegram user id через запятую).
FUNNEL_EDITOR_IDS=
# accounts.id аккаунта Threads; 0 = первый не-paused.
FUNNEL_ACCOUNT_ID=0
# Этап 1 = 0 (бот присылает посты в слот, публикуете сами). Этап 2 = 1 (Threads API).
FUNNEL_AUTOPUBLISH=0
# Решение 2: ветка без ✅ к слоту — skip | publish.
FUNNEL_UNANSWERED=skip
# Решение 3: громкость голоса 1–5.
FUNNEL_VOICE_LEVEL=3
# Решение 5: аккаунты-доноры для тем (без @, через запятую) — попадут в competitors (Apify).
FUNNEL_DONORS=petkova_anjela
# Решение 6: ответы на комментарии — drafts (на апрув) | auto.
FUNNEL_REPLY_MODE=drafts
# Старт системы YYYY-MM-DD: первые 2 недели только новые ветки. Пусто = дата первой ветки.
FUNNEL_START_DATE=
FUNNEL_REPLY_WINDOW_HOURS=2
# Исследование (05:00 МСК): ключевые слова для поиска хитов в Threads и порог прогноза 0–10.
FUNNEL_RESEARCH_QUERIES=нейросеть,ChatGPT,Claude,промпт,ИИ психолог,ИИ ассистент,нейрофото,контент план
FUNNEL_MIN_SCORE=6

# Канал (решение 1). private — своя ссылка-приглашение под каждую ветку (подписки по веткам
# считаются точно); public — ссылка на пост-приёмник (нужен CHANNEL_USERNAME).
# Бот — админ канала с правами публиковать, закреплять и приглашать по ссылкам.
CHANNEL_ID=
CHANNEL_USERNAME=
CHANNEL_MODE=private
# Общая ссылка на канал, пока нет приёмника / прав у бота.
CHANNEL_FALLBACK_LINK=

# MinIO — картинки к посту 1 по временной ссылке (Threads забирает медиа по публичному URL).
MINIO_ENDPOINT=aisales-minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=threads-funnel
MINIO_SECURE=0
MINIO_PUBLIC_SECURE=1

# Голос → текст (правки и /story голосом): self-hosted whisper или OpenAI.
WHISPER_SERVICE_URL=
WHISPER_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Секрет для HTTP-кронов n8n: POST /cron/funnel/<job> с заголовком X-Cron-Secret.
CRON_SECRET=
