# --- Postgres ---
# Local dev:  postgres://aisales:password@localhost:5432/ai_hub
# Production: postgres://aisales:<pwd>@aisales-postgres:5432/ai_hub  (внутри docker network)
DATABASE_URL=postgres://aisales:password@localhost:5432/ai_hub

# --- NextAuth / Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-long-random
NEXTAUTH_URL=http://localhost:3010

# --- SMTP for magic-link emails ---
# Works with any SMTP: Resend, Postmark, SES, Mailgun, or local relay.
# Example for Resend: smtp://resend:<API-KEY>@smtp.resend.com:587
SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_FROM="AI Creative Hub <no-reply@aihub.example.com>"

# --- MinIO / S3 (используем существующий aisales-minio) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-hub-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true                 # обязательно true для MinIO

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- AI Providers ---
FAL_KEY=
REPLICATE_API_TOKEN=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWARE_API_KEY=
MODELSLAB_API_KEY=
# kie.ai — unified marketplace для Nano Banana 2, Veo, Kling и др.
# Получить ключ: https://kie.ai/api-key
KIE_API_KEY=

# --- Webhook callbacks (provider -> us) ---
PROVIDER_WEBHOOK_BASE_URL=https://aihub.46-62-215-11.nip.io

# Each provider signs webhooks differently — set the per-provider secret
# from that provider's dashboard:
#  fal.ai:     dashboard → Webhooks → signing secret  (HMAC SHA-256)
#  Replicate:  https://replicate.com/account/webhook  (Standard Webhooks, "whsec_..." base64)
#  Kling/Runware/ModelsLab: see their docs (TBD, adapters are stubs)
FAL_WEBHOOK_SECRET=
REPLICATE_WEBHOOK_SECRET=
KLING_WEBHOOK_SECRET=
RUNWARE_WEBHOOK_SECRET=
MODELSLAB_WEBHOOK_SECRET=
KIE_WEBHOOK_SECRET=                      # generate: openssl rand -hex 32

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3010
NODE_ENV=development
