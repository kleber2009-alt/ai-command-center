# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Anthropic API key (Claude Haiku 4.5 powers the classifier).
ANTHROPIC_API_KEY=

# Numeric Telegram user id of the bot owner — used for owner-routed
# notifications and DRAFT_FOR_OWNER fallbacks in later stages. Optional
# in stage 1 (we only log decisions, do not actually notify yet).
OWNER_TELEGRAM_ID=

# Comma-separated list of chat ids the bot is allowed to operate in.
# Leave empty to allow every chat (useful while testing). In production
# always pin to specific groups.
ALLOWED_CHAT_IDS=

# Confidence threshold below which the bot will not auto-act on a
# classification (it falls back to DRAFT_FOR_OWNER). 0..1, default 0.7.
CONFIDENCE_THRESHOLD=0.7

# debug | info | warn | error. Default: info.
LOG_LEVEL=info

# Override the Claude model used by the classifier and responder.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
RESPONDER_MODEL=claude-haiku-4-5-20251001

# Supabase project URL and service-role key. When both are set, the bot
# persists chats / users / messages and reads the per-chat auto_reply
# kill switch. When unset, the bot still classifies and replies but
# nothing is saved (stateless mode). Service-role key — never ship to
# the client side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
