# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Anthropic API key (Claude Haiku 4.5 powers the classifier and responder).
ANTHROPIC_API_KEY=

# Numeric Telegram user id of the bot owner. The bot DMs this user on
# REPLY_AND_NOTIFY / NOTIFY_ONLY / DRAFT_FOR_OWNER. Owner must /start
# the bot once — Telegram blocks bot-initiated DMs to silent users.
OWNER_TELEGRAM_ID=

# Comma-separated list of chat ids the bot is allowed to operate in.
# Leave empty to allow every chat (useful while testing). In production
# pin to specific groups.
ALLOWED_CHAT_IDS=

# Confidence threshold below which the bot will not auto-act on a
# classification (it falls back to DRAFT_FOR_OWNER). 0..1, default 0.7.
CONFIDENCE_THRESHOLD=0.7

# debug | info | warn | error. Default: info.
LOG_LEVEL=info

# Override the Claude model used by the classifier and responder.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
RESPONDER_MODEL=claude-haiku-4-5-20251001

# Daily digest generator (DM summary + /pulse, /digest commands).
# Sonnet by default — better Russian + better at surfacing blind
# spots than Haiku. Set DIGEST_ENABLED=false to turn the whole
# feature off without code changes. DIGEST_MODEL falls back to
# INSIGHTS_MODEL if set, for backward compatibility with older .env.
DIGEST_ENABLED=true
DIGEST_MODEL=claude-sonnet-4-6
# UTC hour 0..23 for the daily sweep. 6 UTC = 09:00 MSK.
DIGEST_DAILY_HOUR_UTC=6
# Rolling window each digest covers, in hours.
DIGEST_WINDOW_HOURS=24

# SQLite database file path. Auto-created on first run. In Docker this
# is a bind-mount to /app/data/tg-agent.db so the file survives
# container restarts.
DATABASE_PATH=./data/tg-agent.db

# Admin dashboard — local HTTP server bundled inside the bot process.
# Two auth modes:
#
#  - Basic auth (default): set ADMIN_PASSWORD. Browser caches the
#    creds forever; OK for first-time setup behind HTTPS but the
#    weaker option.
#
#  - Magic link via Telegram (recommended once OWNER_TELEGRAM_ID is
#    set): also set ADMIN_SESSION_SECRET to a random string of at
#    least 16 chars (e.g. `openssl rand -hex 32`). The bot DMs the
#    owner a one-time login link, the link sets a signed-cookie
#    session for 7 days. Rotating ADMIN_SESSION_SECRET logs everyone
#    out everywhere.
#
# If both are set, magic link wins. If neither is set, admin doesn't
# start (bot runs headless).
ADMIN_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. If your admin is behind Caddy / Cloudflare Tunnel and the
# reverse proxy already sets X-Forwarded-Host and X-Forwarded-Proto,
# you can leave this empty — magic-link URLs are derived from each
# request. Set it only if you need to override the host that goes
# into the Telegram DM.
ADMIN_PUBLIC_URL=

# Daily SQLite backup delivered to OWNER_TELEGRAM_ID as a gzipped
# document. Telegram caches files forever — your DM history is the
# backup target, no S3/SFTP needed. Set to 0 to disable.
BACKUP_INTERVAL_HOURS=24

# Health monitor. The bot tracks consecutive Anthropic / Telegram
# failures and DMs the owner when a channel goes down (and again when
# it comes back). HEALTH_FAILURE_THRESHOLD = how many consecutive
# errors before alerting. HEALTH_ALERT_COOLDOWN_MINUTES = silence
# between repeat alerts during a sustained outage.
HEALTH_FAILURE_THRESHOLD=3
HEALTH_ALERT_COOLDOWN_MINUTES=60
