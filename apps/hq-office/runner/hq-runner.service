# Runner of the office working desk (apps/hq-office/runner) — installed by deploy/server.sh.
# Runs under the bots' user: the same Claude Code login and ~/.claude/skills.
[Unit]
Description=hq2.aicex.club office runner (Claude Code tasks for agents)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@HOME@/hq-runner
EnvironmentFile=@HOME@/hq-runner/runner.env
# optional: the Claude Code login of the runner, if it is not ~/.claude/.credentials.json
# (CLAUDE_CODE_OAUTH_TOKEN=… from `claude setup-token`); written by the owner, never by the deploy
EnvironmentFile=-@HOME@/hq-runner/claude.env
Environment=PATH=@HOME@/.local/bin:@HOME@/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -u @HOME@/hq-runner/runner.py
# rendering shares the box with the bots and sites: cap it, and when the cap is hit let the kernel
# kill only the heavy process (the runner stays alive and reports the task as failed for memory)
MemoryHigh=4G
MemoryMax=4608M
OOMPolicy=continue
Restart=always
RestartSec=10
StandardOutput=append:@HOME@/hq-runner/runner.log
StandardError=append:@HOME@/hq-runner/runner.log

[Install]
WantedBy=multi-user.target
