# Club Der Denker backend — copy to .env.local (never commit secrets)

# Database / Supabase (GDPR-compliant server provided by the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (sign user tokens; rotate periodically)
AUTH_SECRET=

# IAP verification
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Web-fallback gateway (optional)
WEB_GATEWAY_WEBHOOK_SECRET=

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cron (Bearer token for /api/cron/inactivity-sweep)
CRON_SECRET=
