# Club Der Denker backend — copy to .env.local (never commit secrets)

# Database / Supabase (GDPR-compliant server provided by the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (sign user tokens; rotate periodically)
AUTH_SECRET=

# Social sign-in (OIDC identity-token audiences; comma-separated client ids)
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# IAP verification
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apple x5c chain pinning (SHA-256 fingerprint of "Apple Root CA - G3").
# Set APPLE_REQUIRE_ROOT_PIN=true to fail closed when the pin is absent.
APPLE_ROOT_CA_FINGERPRINT=
APPLE_REQUIRE_ROOT_PIN=

# Google Play RTDN Pub/Sub push authentication
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SA_EMAIL=

# Web-fallback gateway (HMAC-SHA256 over the raw body, hex, in x-signature)
WEB_GATEWAY_WEBHOOK_SECRET=

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cron (Bearer token for /api/cron/inactivity-sweep)
CRON_SECRET=
