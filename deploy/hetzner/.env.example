# Your domain (must point to the Hetzner box A record)
DOMAIN=transcribe.example.com

# Anthropic (Claude Haiku for generation/summary/translate)
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram (for non-YouTube transcription)
DEEPGRAM_API_KEY=...

# Supabase — managed instance, no migration needed
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# yt-dlp companion service auth (any strong random string)
YTDLP_SERVICE_API_KEY=change-me-to-a-long-random-string

# Optional: base64-encoded cookies.txt for Instagram / YouTube
# INSTAGRAM_COOKIES_B64=
# COOKIES_B64=
