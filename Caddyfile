# Caddy automatically obtains/renews TLS for any real domain.
# For local testing without a domain, set DOMAIN=localhost in .env — Caddy will
# fall back to a self-signed cert; just accept it in the browser.

{$DOMAIN:localhost} {
    encode zstd gzip

    # Static bundles are content-hashed by Next, so they're safe to cache forever.
    @next_static path /_next/static/*
    header @next_static Cache-Control "public, max-age=31536000, immutable"

    # HTML must NOT be cached: each deploy changes the CSS/JS hashes it references,
    # and a stale HTML page would try to load CSS files that no longer exist
    # (Next then returns a 404 HTML page, which the browser sees as "not CSS" and
    # silently drops — producing an unstyled page).
    @html {
        not path /_next/static/*
        not path /api/*
        not path /favicon.ico
        not path /icons/*
        not path /robots.txt
        not path /sitemap.xml
    }
    header @html Cache-Control "no-store, must-revalidate"
    header @html Pragma "no-cache"

    request_body {
        max_size 50MB
    }

    reverse_proxy app:3000 {
        # Preserve streaming for /api/*/chat NDJSON responses
        flush_interval -1
    }
}
