# Caddy reverse proxy for ai-command-center.
#
# Set DOMAIN in .env to your apex (e.g. example.com) or to
# <ipv4>.sslip.io for free HTTPS without owning a domain.
# For local dev, leave DOMAIN unset — Caddy serves on :localhost with
# a self-signed cert.

{$DOMAIN:localhost} {
	# Auth for /admin, /me, /assistants and their data-plane APIs is
	# enforced inside the Next.js app via middleware (see
	# apps/transcribe/src/middleware.ts). Caddy just proxies through.
	reverse_proxy transcribe:3000
}

# Legacy static site under a subdomain.
# Comment this block out if you don't have office.<domain> set up.
office.{$DOMAIN:localhost} {
	reverse_proxy ai-office:80
}
