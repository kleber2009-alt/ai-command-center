# Caddy automatically obtains/renews TLS for any real domain.
# For local testing without a domain, set DOMAIN=localhost in .env — Caddy will
# fall back to a self-signed cert; just accept it in the browser.

{$DOMAIN:localhost} {
    encode zstd gzip

    # Big enough body for file uploads (.pdf, .docx)
    request_body {
        max_size 50MB
    }

    reverse_proxy app:3000 {
        # Preserve streaming for /api/*/chat NDJSON responses
        flush_interval -1
    }
}
