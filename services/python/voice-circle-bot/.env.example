# Telegram bot token — создай нового бота через @BotFather
TELEGRAM_BOT_TOKEN=

# Claude API key (тот же что у tg-agent)
ANTHROPIC_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=      # ID голоса в ElevenLabs (Settings → API → Voice ID)

# Чьи сообщения игнорировать (владелец + команда)
OWNER_TELEGRAM_ID=1280515130
IGNORED_USER_IDS=256120033,923980789

# Чаты в которых работает бот (пусто = все группы)
ALLOWED_CHAT_IDS=

# Поведение Claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_RESPONSE_TOKENS=180
SYSTEM_PROMPT=Ты голосовой ассистент в Telegram-группе. Отвечай коротко и по делу на русском языке. Максимум 2–3 предложения — ответ будет озвучен голосом.
