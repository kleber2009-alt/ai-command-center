{
  "name": "ai-command-center",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/transcribe",
    "apps/tg-agent",
    "apps/persona-studio"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/transcribe",
    "build": "npm run build -w apps/transcribe",
    "start": "npm run start -w apps/transcribe",
    "lint": "npm run lint -w apps/transcribe",
    "tg-agent:dev": "npm run dev -w apps/tg-agent",
    "tg-agent:build": "npm run build -w apps/tg-agent",
    "tg-agent:start": "npm run start -w apps/tg-agent",
    "tg-agent:typecheck": "npm run typecheck -w apps/tg-agent",
    "persona:dev": "npm run dev -w apps/persona-studio",
    "persona:build": "npm run build -w apps/persona-studio",
    "persona:start": "npm run start -w apps/persona-studio",
    "persona:typecheck": "npm run typecheck -w apps/persona-studio",
    "persona:worker:avatar": "npm run worker:avatar -w apps/persona-studio",
    "persona:worker:cover": "npm run worker:cover -w apps/persona-studio"
  }
}
