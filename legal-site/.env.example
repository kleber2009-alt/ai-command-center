# Telegram-бот для приёма заявок с сайта.
# 1. Создай бота через @BotFather → получишь TELEGRAM_BOT_TOKEN.
# 2. Создай группу/канал, добавь бота админом, отправь туда любое сообщение.
# 3. Открой https://api.telegram.org/bot<token>/getUpdates → найди chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичные контакты, отображаются в блоке "Связаться напрямую".
# Telegram-юзернейм без @, например: legal_company
NEXT_PUBLIC_TELEGRAM_USERNAME=
# WhatsApp в международном формате без + и пробелов, например: 79991234567
NEXT_PUBLIC_WHATSAPP_PHONE=
