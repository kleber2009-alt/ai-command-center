# ═══════════════════════════════════════════════════════════════════
# infra/.env — secrets for docker compose
# ───────────────────────────────────────────────────────────────────
# Copy to infra/.env on your server, fill values, never commit.
# ═══════════════════════════════════════════════════════════════════

# ── Domain & TLS ──
# Single domain serves both ai-office (root) and transcribe (/transcribe).
# Caddy auto-issues Let's Encrypt certs.
PUBLIC_HOST=ai-growth-office.ru
PUBLIC_BASE_URL=https://ai-growth-office.ru

# Email for Let's Encrypt notifications (cert renewal failures).
ACME_EMAIL=admin@ai-growth-office.ru

# ── Postgres ──
POSTGRES_DB=aio
POSTGRES_USER=aio
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# ── External APIs ──
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...

# ── Telegram bots ──
# notify-tg (admin notifications about leads, payments, etc.)
TG_BOT_TOKEN=
TG_CHAT_ID=

# voice composer bot (Phase 5)
TG_VOICE_BOT_TOKEN=
TG_WEBHOOK_SECRET=optional_random_32+_chars

# Phase 5 · Commit 4 — subscriber relay flow:
# Если задан — все subscriber-сообщения уйдут именно этому owner_handle.
# Если пусто — берётся первый активный voice_bot_users row (single-tenant).
TG_VOICE_BOT_OWNER=

# ── yt-dlp microservice (optional, transcribe app) ──
# If running ytdlp service alongside, set to http://ytdlp:8000
YTDLP_SERVICE_URL=
YTDLP_SERVICE_API_KEY=
