# ═══════════════════════════════════════════════════════════════════
# infra/.env — secrets for docker compose
# ───────────────────────────────────────────────────────────────────
# Copy to infra/.env on your server, fill values, never commit.
# ═══════════════════════════════════════════════════════════════════

# ── Domain & TLS ──
# Single domain serves both ai-office (root) and transcribe (/transcribe).
# Caddy auto-issues Let's Encrypt certs.
PUBLIC_HOST=ai-office.46-62-215-11.nip.io
PUBLIC_BASE_URL=https://ai-office.46-62-215-11.nip.io

# Email for Let's Encrypt notifications (cert renewal failures).
ACME_EMAIL=admin@ai-office.46-62-215-11.nip.io

# ── Postgres ──
POSTGRES_DB=aio
POSTGRES_USER=aio
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# ── External APIs ──
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
# Used by /me library for document embeddings (text-embedding-3-small).
# If empty, /me/library can't ingest new docs; /me/chat falls back to profile-only.
OPENAI_API_KEY=sk-...

# ── Telegram bots ──
# notify-tg (admin notifications about leads, payments, etc.)
TG_BOT_TOKEN=
TG_CHAT_ID=

# voice composer bot (Phase 5)
TG_VOICE_BOT_TOKEN=
TG_WEBHOOK_SECRET=optional_random_32+_chars

# Phase 5 · Commit 4 — subscriber relay flow:
# Если задан — все subscriber-сообщения уйдут именно этому owner_handle.
# Если пусто — берётся первый активный voice_bot_users row (single-tenant).
TG_VOICE_BOT_OWNER=

# Telegram Mini App auth gate for the transcribe app.
# When set, every /api/* route on the transcribe service requires a valid
# `Authorization: tma <initData>` header. Leave empty to keep the API open.
TELEGRAM_BOT_TOKEN=

# ── yt-dlp microservice ──
# Runs inside this compose stack at http://ytdlp:8000.
# Shared bearer token between transcribe and ytdlp containers.
YTDLP_SERVICE_API_KEY=
# Optional: leave empty to use the in-stack ytdlp; set to override.
YTDLP_SERVICE_URL=

# Optional yt-dlp cookies (base64 of cookies.txt). Helps with IG/YouTube
# rate limits or age-gated content.
INSTAGRAM_COOKIES_B64=
COOKIES_B64=
