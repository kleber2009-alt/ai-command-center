# ═══════════════════════════════════════════════════════════════════
# Ready-to-use /etc/caddy/Caddyfile for aisales-prod server
# ───────────────────────────────────────────────────────────────────
# Contains BOTH:
#   · api.46-62-215-11.nip.io → 127.0.0.1:8001 (existing aisales API)
#   · 46.62.215.11.nip.io     → ai-office (3001) + transcribe (3002)
#
# Install:
#   cd ~/ai-command-center && git pull
#   cp infra/snippets/full-caddyfile.aisales-prod.example /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
# ═══════════════════════════════════════════════════════════════════

# AI Sales · auto SSL через Let's Encrypt + nip.io

api.46-62-215-11.nip.io {
	reverse_proxy 127.0.0.1:8001

	log {
		output file /var/log/caddy/api.log
		format console
	}

	header {
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

# AI Growth Office + Transcribe — наш стек
46.62.215.11.nip.io {
	encode zstd gzip

	# Next.js (/transcribe, /assistants, /me и все их /api/*)
	@nextjs path \
		/transcribe /transcribe/* \
		/assistants /assistants/* \
		/me /me/* \
		/api/transcribe /api/transcribe/* \
		/api/assistants /api/assistants/* \
		/api/me /api/me/* \
		/api/voice /api/voice/*
	handle @nextjs {
		reverse_proxy 127.0.0.1:3002
	}

	# Всё остальное → ai-office Fastify (static HTML + /api/* + /voice-notes/*)
	handle {
		reverse_proxy 127.0.0.1:3001
	}

	log {
		output file /var/log/caddy/aio.log
		format console
	}
}
