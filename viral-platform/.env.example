# --- Postgres + Redis (match docker-compose.yml for local dev) ---
DATABASE_URL=postgresql://viral:viral@localhost:5432/viral_platform
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Storage (Cloudflare R2 / MinIO locally) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=viral
R2_SECRET_ACCESS_KEY=viralsecret
R2_BUCKET_VIDEO=viral-videos
R2_PUBLIC_URL=http://localhost:9000/viral-videos
R2_ENDPOINT=http://localhost:9000
UPLOADTHING_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=

# --- B-roll providers ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
AXIOM_TOKEN=

# --- Models (override defaults from packages/shared/constants) ---
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MODEL_CHEAP=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-large
