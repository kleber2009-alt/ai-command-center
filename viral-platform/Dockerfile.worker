# Shared image for all BullMQ workers + the DB migrator. Includes ffmpeg
# (transcribe/library/render need it). The compose `command` selects which
# worker to run. Built from the monorepo root:
#   docker build -f viral-platform/Dockerfile.worker viral-platform
FROM node:22-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
# Default; overridden per service in docker-compose.prod.yml.
CMD ["pnpm", "--filter", "@vp/worker-broll", "exec", "tsx", "src/index.ts"]
