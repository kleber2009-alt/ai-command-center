# DEMO MODE — zero external keys. No Clerk, no auth: anyone who can reach the
# site uses it as a shared demo user. The UI runs, but video processing still
# needs AI/R2 keys (jobs fail without them; credits are refunded).
#
#   cp .env.demo.example .env && nano .env   # change the password
#   ./scripts/deploy.sh
NODE_ENV=production
NEXT_PUBLIC_AUTH_DISABLED=true

# Postgres — pick any password (DB is internal-only).
POSTGRES_USER=viral
POSTGRES_PASSWORD=demo_change_me
POSTGRES_DB=viral_platform
DATABASE_URL=postgresql://viral:demo_change_me@vp-postgres:5432/viral_platform
REDIS_URL=redis://vp-redis:6379

# Bucket names (R2 keys empty → uploads won't work until you add them).
R2_BUCKET_VIDEO=viral-videos
R2_BUCKET_LIBRARY=user-library

# Everything below can stay empty for a UI-only demo; fill in to enable the
# actual pipeline (transcribe → detect → b-roll → render) and uploads.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
