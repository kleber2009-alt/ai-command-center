# ═══════════════════════════════════════════════════════════════════════
# .env.example — копируй в .env и заполни своими значениями.
# Все переменные опциональны: если что-то не задано, соответствующий
# /api/* эндпоинт ответит 503 с понятным сообщением, остальная статика
# работает.
# ═══════════════════════════════════════════════════════════════════════

# ── /api/chat: прокси к Anthropic Messages API ────────────────────────
# Получи ключ в https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── /api/notify-tg: отправка уведомлений в Telegram ───────────────────
# Создай бота в @BotFather, узнай свой chat_id у @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── /api/voice-clone, /api/voice-generate: ElevenLabs ─────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── Supabase: нужен для voice-* функций (хранение голосов и mp3) ──────
# Project URL: Project Settings → API → Project URL
SUPABASE_URL=
# service_role key — даёт полный доступ к БД, НИКОГДА не светить клиенту.
SUPABASE_SERVICE_KEY=
# anon key — нужен только для /api/voice-list (publicly readable).
SUPABASE_ANON_KEY=

# ── Сервер ────────────────────────────────────────────────────────────
# Внутренний порт процесса (наружу в docker-compose маппится 80:8080).
PORT=8080
HOST=0.0.0.0
