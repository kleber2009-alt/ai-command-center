# Copy to .env and fill in.
# Required values are marked. Optional ones have sensible defaults.

# --- Domain (used by Caddy for auto-HTTPS) ---
DOMAIN=transcribe.example.com

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=          # REQUIRED — generate with: openssl rand -hex 24
POSTGRES_DB=app

# --- AI providers ---
ANTHROPIC_API_KEY=          # REQUIRED — used by summarize/translate/generate/chat
DEEPGRAM_API_KEY=           # REQUIRED for direct media files + yt-dlp pipeline
OPENAI_API_KEY=             # optional — needed for /me embeddings + RAG

# --- yt-dlp shared secret (used by app → ytdlp service inside the network) ---
YTDLP_SERVICE_API_KEY=      # REQUIRED — generate with: openssl rand -hex 32

# --- Social cookies (base64-encoded Netscape cookies.txt) ---
# Combine YouTube + Instagram cookies into one file before encoding.
COOKIES_B64=
INSTAGRAM_COOKIES_B64=

# --- Access control ---
# /admin and /api/tasks are protected by HTTP Basic Auth when this is set.
# Format: "user:password". Browser auto-prompts.
ADMIN_BASIC_AUTH=

# /api/transcribe and /api/me verify Telegram Mini App `initData` against
# this token when set. Get it from @BotFather → /mybots → your bot →
# API Token. Leave empty during local dev to keep API open.
TELEGRAM_BOT_TOKEN=
