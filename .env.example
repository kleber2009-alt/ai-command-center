# ═══════════════════════════════════════════════════════════════════════
# .env.example — полная конфигурация self-hosted стека.
# Скопируй в .env и заполни.
# ═══════════════════════════════════════════════════════════════════════

# ── Postgres (создаётся docker-compose) ───────────────────────────────
POSTGRES_USER=ai
POSTGRES_PASSWORD=                    # ОБЯЗАТЕЛЬНО задай сильный пароль
POSTGRES_DB=ai

# DATABASE_URL формируется автоматически в docker-compose из POSTGRES_*.
# Указывать вручную здесь не нужно — оставлено для справки.
# DATABASE_URL=postgres://ai:PASSWORD@postgres:5432/ai

# ── Anthropic (чат, summarize, translate, генерации) ──────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Deepgram (транскрипция аудио в Next.js приложении) ────────────────
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ── OpenAI (эмбеддинги для RAG в /me/library) ─────────────────────────
# https://platform.openai.com/api-keys
# Можно оставить пустым — RAG в /me/chat просто отключится.
OPENAI_API_KEY=

# ── ElevenLabs (клонирование голоса /api/voice-*) ─────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── Telegram Bot (уведомления /api/notify-tg + Mini App) ──────────────
# Получи токен у @BotFather, chat_id у @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=
TELEGRAM_BOT_TOKEN=                   # дублирует TG_BOT_TOKEN, нужно для transcribe

# ── yt-dlp companion service (Instagram, TikTok, X, YouTube fallback) ──
# В docker-compose Next.js видит сервис как http://ytdlp:8080 без ключа.
# Если открываешь ytdlp наружу — задай Bearer.
YTDLP_SERVICE_API_KEY=

# Опциональные cookies (base64 .txt в формате Netscape) для Instagram/YouTube.
# COOKIES_B64=
# INSTAGRAM_COOKIES_B64=

# ── ai-office voice notes ─────────────────────────────────────────────
# Куда писать mp3 от voice-generate (внутри контейнера). Снаружи лежит в
# docker volume `voice-notes`. Раздаётся клиентам по /files/voice-notes/.
VOICE_NOTES_DIR=/data/voice-notes
VOICE_NOTES_PUBLIC_URL=/files/voice-notes
