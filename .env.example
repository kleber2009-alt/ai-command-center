# Copy to `.env` and fill in. `.env` is read by docker-compose at startup.

# Required for the assistants chat, second-brain chat, transcribe summary/translate/generate.
ANTHROPIC_API_KEY=

# Required for the second-brain library: embeddings (text-embedding-3-small).
# Without it, /me/library can't ingest documents and /me/chat falls back to
# profile-only context.
OPENAI_API_KEY=

# Required for non-YouTube transcribe URLs and as the yt-dlp fallback for YouTube.
DEEPGRAM_API_KEY=

# yt-dlp companion service auth — set the same value here and in the ytdlp service.
# Leave blank to disable the bearer-token check.
YTDLP_SERVICE_API_KEY=

# Optional base64-encoded cookies for yt-dlp (see services/ytdlp/README.md).
# Required for most Instagram URLs and many YouTube videos in datacenter IPs.
COOKIES_B64=
INSTAGRAM_COOKIES_B64=

# When set, every /api/* route requires a valid Telegram Mini App initData
# in the Authorization header (`tma <initData>`). The browser client sends it
# automatically when opened inside Telegram. Leave empty to keep the API open
# (suitable for local dev or when you put basic-auth in front via Caddy).
TELEGRAM_BOT_TOKEN=

# Domain Caddy serves. Set to your real domain in prod, "localhost" for local Docker.
DOMAIN=localhost
