# Copy to .env and fill in. docker compose reads .env from the repo root.

# Your domain — Caddy uses this for auto-HTTPS. Leave as "localhost" for
# local dev (Caddy will issue a self-signed cert).
DOMAIN=example.com

# Postgres password. Used by both Postgres and the transcribe app's
# DATABASE_URL. Pick something long and random.
POSTGRES_PASSWORD=change-me-please

# Anthropic API key — needed for summarize / translate / generate / me-chat.
ANTHROPIC_API_KEY=

# Deepgram API key — needed for non-YouTube transcription paths.
DEEPGRAM_API_KEY=

# OpenAI API key — needed for /me document embeddings.
OPENAI_API_KEY=

# Optional shared secret between transcribe and ytdlp services. If set,
# the ytdlp service requires Authorization: Bearer <key>.
YTDLP_SERVICE_API_KEY=

# Optional: base64-encoded cookies.txt files for yt-dlp (Instagram and
# general). See apps/ytdlp/README.md for how to produce them.
INSTAGRAM_COOKIES_B64=
COOKIES_B64=

# HTTP Basic Auth for the private surfaces (/admin, /me, /assistants,
# and their data-plane APIs). /transcribe stays open so the Telegram
# Mini App works for anonymous users.
#
# Generate a strong password (32+ chars) — e.g. `openssl rand -base64 32`.
# When ADMIN_PASSWORD is left blank, the private paths return 401 on
# every request. Setting it is mandatory before /admin is reachable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram bot token from @BotFather. When set, /api/transcribe/* is
# protected by server-side verification of the Mini App's `initData`
# (HMAC-SHA256 against the bot token, per Telegram's spec). When unset
# the endpoint is open — leave that for local dev only. Production
# without this set is wide-open and will burn Anthropic / Deepgram
# credits if anyone discovers your URL.
TELEGRAM_BOT_TOKEN=
