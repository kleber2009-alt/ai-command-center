# AI Command Center · environment variables
# Скопируй в .env.local для локалки, в .env на сервере.

# ============ Postgres ============
# Локально (контейнер ai-sales/code/docker-compose поднимает Postgres на 127.0.0.1:5432):
DATABASE_URL=postgresql://aisales:aisales_local_dev@127.0.0.1:5432/aisales

# Внутри docker compose (когда дашборд тоже в контейнере, см. Фазу 3):
# DATABASE_URL=postgresql://aisales:aisales_local_dev@postgres:5432/aisales

# ============ Anthropic ============
# Используется в src/app/api/command/route.ts
ANTHROPIC_API_KEY=sk-ant-...
